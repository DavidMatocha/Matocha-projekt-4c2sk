@model IEnumerable<WebApplication_CarService.Models.ServiceRecord>

@{
    var car = (WebApplication_CarService.Models.Car)ViewBag.Car;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Servisní historie – @car.Brand @car.Model</h2>

    <a class="btn btn-primary"
       asp-controller="ServiceRecords"
       asp-action="Create"
       asp-route-carId="@car.Id">
        + Přidat záznam
    </a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Datum</th>
            <th>Km</th>
            <th>Název</th>
            <th>Cena</th>
            <th class="text-end">Akce</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Date.ToShortDateString()</td>
                <td>@r.Mileage</td>
                <td>@r.Title</td>
                <td>@(r.Cost.HasValue? r.Cost.Value.ToString("0.00") : "-")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="Edit"
                       asp-route-id="@r.Id">Upravit</a>

                    <a class="btn btn-sm btn-outline-danger"
                       asp-action="Delete"
                       asp-route-id="@r.Id">Smazat</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-link" asp-controller="Cars" asp-action="Index">← Zpět na auta</a>
