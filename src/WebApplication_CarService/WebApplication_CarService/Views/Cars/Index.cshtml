@model List<WebApplication_CarService.Models.Car>

<h2>Seznam aut</h2>
<br />
<a asp-action="Create"><button class="btn btn-primary" type="submit">Přidat auto</button></a>

<table class="table table-striped table-hover align-middle">
<thead>
    <tr>
        <th>Značka</th>
        <th>Model</th>
        <th>Akce</th>
    </tr>
</thead>

    @foreach (var car in Model)
    {
        <tr>
            <td> @car.Brand </td>
            <td> @car.Model </td>
            <td>
                <a asp-controller="ServiceRecords"
                   asp-action="Index"
                   asp-route-carId="@car.Id">
                  <button class="btn btn-outline-primary" type="submit">Servisní knížka</button>
                </a>

                <a asp-action="Edit" asp-route-id="@car.Id"><button class="btn btn-outline-secondary" type="submit">Upravit</button></a>
                <a asp-action="Delete" asp-route-id="@car.Id"><button class="btn btn-outline-danger" type="submit">Smazat</button></a>
            </td>
        </tr>
    }
</table>

