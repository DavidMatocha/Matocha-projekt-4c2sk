@model WebApplication_CarService.Models.Car

<h2>Smazat auto</h2>

<p>Opravdu chceš smazat auto <strong>@Model.Brand @Model.Model</strong>?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-primary" type="submit">Ano, smazat</button>
</form>
<br />
<a asp-action="Index"><button class="btn btn-outline-primary" type="submit">Zpět</button></a>
