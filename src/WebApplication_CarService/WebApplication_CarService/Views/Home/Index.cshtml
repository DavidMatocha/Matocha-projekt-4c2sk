@if (User?.Identity?.IsAuthenticated == true)
{
    <p>Přihlášen: @User.Identity.Name</p>
    <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-danger">Logout</button>
    </form>
}
else
{
    <p>Nepřihlášen</p>
}
