
@if (User?.Identity?.IsAuthenticated == true)
{
    <h3>Přihlášen: @User.Identity.Name</h3>
    <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-danger">Logout</button>
    </form>
}
else
{
    <h3>Nepřihlášen </h3>
}
