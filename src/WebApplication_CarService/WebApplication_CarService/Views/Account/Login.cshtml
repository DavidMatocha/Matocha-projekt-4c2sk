@model WebApplication_CarService.ViewModels.Account.LoginViewModel

<h2 class="mb-3">Přihlášení</h2>

@if (TempData["Info"] is string info)
{
    <div class="alert alert-info">@info</div>
}

<form asp-action="Login" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Heslo</label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label class="form-check-label">Zapamatovat si mě</label>
    </div>

    <button class="btn btn-primary" type="submit">Odeslat</button>
    <a class="btn btn-link" asp-action="Register">Nemám účet</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
